<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification</title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background-color: #f4f6f9;
        margin: 0;
        padding: 0;
        color: #333333;
      }
      .wrapper {
        width: 100%;
        background-color: #f4f6f9;
        padding: 40px 0;
      }
      .container {
        max-width: 460px;
        margin: 0 auto;
        background: #ffffff;
        padding: 40px 32px;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        border: 1px solid #eef2f6;
      }
      .header {
        text-align: center;
        margin-bottom: 24px;
      }
      .icon-circle {
        width: 60px;
        height: 60px;
        background: #eef2ff;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
      }
      .header h2 {
        color: #1e293b;
        font-size: 22px;
        font-weight: 700;
        margin: 0;
      }
      p {
        font-size: 15px;
        line-height: 1.6;
        color: #475569;
        margin: 0 0 16px 0;
      }
      .user-name {
        font-weight: 600;
        color: #0f172a;
      }
      .otp-wrapper {
        text-align: center;
        margin: 28px 0;
      }
      .otp {
        display: inline-block;
        padding: 14px 32px;
        background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
        color: #ffffff;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: 8px;
        border-radius: 10px;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
        text-indent: 8px; /* Alignment for letter-spacing */
      }
      .alert-box {
        background-color: #fffbeb;
        border-left: 4px solid #f59e0b;
        padding: 12px 16px;
        border-radius: 6px;
        margin-top: 24px;
      }
      .alert-box p {
        color: #b45309;
        font-size: 13px;
        margin: 0;
        line-height: 1.5;
      }
      .footer {
        margin-top: 32px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
        font-size: 12px;
        color: #94a3b8;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header with Lock Icon -->
        <div class="header">
          <div class="icon-circle">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h2>Email Verification Request</h2>
        </div>

        <!-- Body Content -->
        <p>Hello <span class="user-name"><%= name %></span>,</p>
        <p>We received a request to verify your email <%= email %> <strong>PH Healthcare System</strong> account.</p>
        <p style="text-align: center; margin-bottom: 8px; font-weight: 500;">Use the OTP below to verify your email:</p>
        
        <!-- OTP Display -->
        <div class="otp-wrapper">
          <div class="otp"><%= otp %></div>
        </div>

        <!-- Expiration Alert Box -->
        <div class="alert-box">
          <p><strong>Notice:</strong> This OTP will expire in <strong><%= expirationSeconds %> minutes</strong>. If you did not request a email verification, please ignore this email.</p>
        </div>

        <!-- Footer -->
        <div class="footer">
          &copy; <%= new Date().getFullYear() %> <strong>PH Healthcare System</strong>. All rights reserved.
        </div>
      </div>
    </div>
  </body>
</html>